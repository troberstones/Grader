# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# app storage (uploads, db, thumbnails)
/storage/

# test media (local only — filenames may contain real student names)
testData/**/*.png
testData/**/*.jpg
testData/**/*.jpeg
testData/**/*.mp4
testData/**/*.mov
testData/**/*.gif
testData/**/*.webm

# pdf.js worker — copied from node_modules by `npm run sync:pdf-worker`
# (runs on predev/prebuild). Not committed so it cannot drift from the
# installed pdfjs-dist version.
/public/pdf.worker.min.mjs
