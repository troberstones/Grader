{
  "manifest_version": 3,
  "name": "LS Bridge – Grader Sync",
  "version": "1.0.0",
  "description": "Bridges the Grader app with BYU Learning Suite for roster, assignment, submission, and grade sync.",

  "permissions": ["storage", "tabs"],

  "host_permissions": [
    "https://learningsuite.byu.edu/*",
    "http://localhost:*/*",
    "https://localhost:*/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LS Bridge"
  },

  "content_scripts": [
    {
      "matches": ["https://learningsuite.byu.edu/*"],
      "js": ["content_ls.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:*/*", "https://localhost:*/*"],
      "js": ["content_grader.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": ["http://localhost:*/*", "https://localhost:*/*"],
      "js": ["inject.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["http://localhost:*/*", "https://localhost:*/*"]
    }
  ]
}
