# All of these are optional — the app runs with sensible defaults for local
# development on the studio LAN without setting any of them.

# Path to the SQLite database file. Defaults to ./storage/grader.db.
# DB_PATH=./storage/grader.db

# Set to 1 once this is served over HTTPS, so session/invite cookies get the
# `secure` flag. Leave unset on the studio LAN. See docs/security.md.
# SECURE_COOKIES=1

# Absolute base URL this app is reachable at — used to build links sent in
# invite/password-reset emails. The copy-link flow in /admin/users works
# without this; email sending is skipped entirely when it's unset.
# APP_BASE_URL=http://cs-1017245.cs.byu.edu:3000

# ── Mail ──────────────────────────────────────────────────────────────────
# Invites, password resets, upload links and feedback all go out one of two
# ways. With SMTP_HOST set, through that provider's submission port using a
# real account; otherwise through a local sendmail binary. The deploy host
# has no sendmail (and no root to install one), so there it has to be SMTP.
#
# Gmail / Google Workspace: smtp.gmail.com, 587, the full address, and an app
#   password (Google Account → Security → App passwords; needs 2-step on).
# iCloud: smtp.mail.me.com, 587, the iCloud address, and an app-specific
#   password from account.apple.com.
# Put these in .env.local on the server — it's gitignored, and deploy-remote.sh
# leaves it in place.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop

# From: address. Defaults to SMTP_USER; most providers refuse any other
# address unless it's a verified alias of that account.
# MAIL_FROM=grader@cs.byu.edu

# Without SMTP_HOST: path to a local sendmail-compatible binary (no
# credentials — it hands mail to whatever transport the host already has).
# Defaults to /usr/sbin/sendmail.
# SENDMAIL_PATH=/usr/sbin/sendmail

# Comma-separated Origin values allowed to make a cross-site, credentialed,
# state-changing request — everything else with a mismatched Origin/Host is
# rejected by apiRequireCapability() (src/lib/auth/api.ts). This exists for
# the LS Bridge extension's background service worker, which posts to
# /api/submissions/upload from chrome-extension://<id>, not from a page on
# this origin. Get <id> from chrome://extensions with Developer mode on.
# Leave unset if the LS Bridge extension isn't installed. See docs/security.md.
# ALLOWED_EXTENSION_ORIGINS=chrome-extension://abcdefghijklmnopqrstuvwxyzabcdef

# server.mjs overwrites the x-forwarded-for (and x-real-ip) header with the
# actual TCP socket address on every request, because this process is the
# edge itself — nothing in front of it can be trusted to have set that header
# honestly, and the login throttle and audit log both rely on it. Set this to
# 1 only if grader is ever moved behind a real reverse proxy that sets
# x-forwarded-for itself, so server.mjs stops clobbering it.
# TRUST_PROXY=1

# Feedback email (Assignments → "Send feedback to students"). Until this is
# set to 1, every feedback email is redirected to the instructor who sends it,
# with the intended student named in the subject — so the layout and frames
# can be checked against a real inbox without anything reaching a student.
# Test sends are tracked separately from real ones. The "link to view online"
# option also needs APP_BASE_URL above.
# FEEDBACK_EMAIL_STUDENTS=1

# ffmpeg used to pull annotated video frames for feedback email. Defaults to
# `ffmpeg` on PATH, same as ingest.
# FFMPEG_PATH=/usr/bin/ffmpeg
