{
  "name": "grader",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "review:migrate": "node scripts/apply-review-migration.mjs",
    "review:ingest": "node scripts/ingest-review-media.mjs",
    "review:test": "npm test --workspace @grader/art-review",
    "sync:pdf-worker": "cp node_modules/pdfjs-dist/build/pdf.worker.min.mjs public/pdf.worker.min.mjs",
    "predev": "npm run sync:pdf-worker",
    "prebuild": "npm run sync:pdf-worker",
    "review:import-sequence": "node scripts/import-sequence.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@grader/art-review": "*",
    "ag-psd": "^31.0.2",
    "better-sqlite3": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "fabric": "^7.2.0",
    "lucide-react": "^1.7.0",
    "mp4box": "^0.5.4",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "shadcn": "^4.1.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
